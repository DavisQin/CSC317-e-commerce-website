extends layout

block content
  .product-detail-layout
    img.product-detail-img(src=product.image_url || 'https://placehold.co/300x380/1a1a2e/ffffff?text=' + encodeURIComponent(product.name) alt=product.name)
    .product-detail
      h1= product.name
      table.detail-table
        tr
          th Brand
          td= product.brand
        tr
          th Category
          td= product.category
        tr
          th Price
          td $#{product.price.toFixed(2)}
        tr
          th Stock
          td= product.stock
        tr
          th Availability
          td
            if product.stock > 0
              span.badge.in-stock In Stock
            else
              span.badge.out-of-stock Out of Stock
      if product.stock > 0
        form(action='/cart/add' method='POST')
          input(type='hidden' name='product_id' value=product.id)
          button.btn.btn-add(type='submit') Add to Cart
      a.btn(href='/products') Back to Products
