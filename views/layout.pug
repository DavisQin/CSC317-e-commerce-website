doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title || "Men's Clothing Store"
    link(rel='stylesheet', href='/css/style.css')
  body
    nav.navbar
      a.brand(href='/') MenStyle
      ul
        li: a(href='/') Home
        li: a(href='/products') Products
        if currentUser
          li: a(href='/orders') My Orders
          li: a(href='/cart') Cart#{cartCount > 0 ? ' (' + cartCount + ')' : ''}
          li: span.nav-user Hi, #{currentUser.username}
          li
            form(action='/logout' method='POST' style='display:inline')
              button.btn-nav(type='submit') Logout
        else
          li: a(href='/cart') Cart
          li: a(href='/login') Login
          li: a(href='/register') Register

    main.content
      block content

    footer
      p &copy; 2026 MenStyle &mdash; CSC317 Group Project | Lior Elbert &amp; Davis Qin
